APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
CORS_ALLOWED_ORIGINS=http://localhost:3000
CORS_ALLOWED_ORIGIN_PATTERNS='#^http://[a-z0-9-]+\.localhost:3000$#'

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=multi_tenant_ecommerce
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=resend
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
RESEND_API_KEY=


AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Stripe — fill these in from https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
STRIPE_SESSION_EXPIRES_MINUTES=60
STOREFRONT_URL="http://{slug}.localhost:3000"

# ---------------------------------------------------------------------------
# Platform billing — shops paying THIS platform for the SaaS.
# Opposite direction to the Stripe block above (Connect: customer -> shop).
# Here the platform is merchant of record and charges on its own account.
#
# A shop is billed in ITS OWN currency (tenants.currency, chosen at signup and
# immutable) into an account in its own country — a shop inside Myanmar cannot
# easily wire Baht to a Thai bank. Tenants whose currency has no entry below
# (USD today) fall back to BILLING_DEFAULT_CURRENCY.
# ---------------------------------------------------------------------------
BILLING_DEFAULT_CURRENCY=THB

# --- Thai Baht -------------------------------------------------------------
# Major units. PLACEHOLDERS — set these deliberately before taking real money.
BILLING_THB_STARTER_AMOUNT=499
BILLING_THB_PRO_AMOUNT=699
# Stripe Price ids: the price_... id, NOT the prod_... one. Created in the
# Stripe dashboard as recurring/monthly. Test and live mode issue DIFFERENT
# ids, so these change at go-live.
# LIVE-mode ids, kept for the production env. A test key cannot use these.
BILLING_THB_STARTER_PRICE_ID=
BILLING_THB_PRO_PRICE_ID=
# The PLATFORM's own Thai account — where shops transfer their fee TO. Not a
# credential (it is shown to every shop that picks transfer), and not the
# shop's own bank details, which live on tenant_payment_methods.
BILLING_THB_BANK_NAME=
BILLING_THB_ACCOUNT_NAME=
BILLING_THB_ACCOUNT_NUMBER=
BILLING_THB_INSTRUCTIONS=

# --- Myanmar Kyat ----------------------------------------------------------
# No Stripe price ids here, and there never will be: Stripe does not support
# MMK, so card is structurally unavailable to a Myanmar shop and transfer is
# the only rail. This is precisely why the manual rail exists.
BILLING_MMK_STARTER_AMOUNT=69000
BILLING_MMK_PRO_AMOUNT=89000
# The PLATFORM's own Myanmar account.
BILLING_MMK_INSTRUCTIONS=

# --- Trial, grace, webhook -------------------------------------------------
# New shops trial the TOP plan, so they see what they'd be paying for.
BILLING_TRIAL_PLAN=pro
BILLING_TRIAL_DAYS=14
# Full access kept after a period ends unpaid, before going read-only.
# Transfer gets the longer window: it must be sent, clear, and then be checked
# by a human here. A card either works or it doesn't.
BILLING_GRACE_DAYS=7
BILLING_MANUAL_GRACE_DAYS=14
BILLING_MANUAL_ENABLED=true
# From the SEPARATE endpoint you register at /api/v1/webhooks/billing/stripe.
# Stripe issues a different signing secret per endpoint; sharing one with
# STRIPE_WEBHOOK_SECRET would let either endpoint accept the other's traffic.
STRIPE_BILLING_WEBHOOK_SECRET=
# Where Stripe returns the shop OWNER after paying (admin app). Landing here
# is not proof of payment — the page must re-read the real state.
BILLING_RETURN_PATH=/settings/billing
